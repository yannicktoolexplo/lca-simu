    "minimum_horizon_days": 720,
    "minimum_warmup_days": 240,
    "require_measurement_start_state_hash_pairing": true,
    "require_untreated_incident_application": true,
    "require_positive_incremental_customer_backlog": false
  },
  "study_assumptions": {
    "source_graph_is_never_modified": true,
    "historical_cold_start_is_never_overwritten": true,
    "added_initialization_target_scale": 0.1,
    "added_initialization_target_scale_reason": "The shared --initial-state-scale flag scales only added initialization targets; it does not scale the observed ERP inventory snapshots. The quality cascade therefore uses separate, pair-scoped and audited stock sensitivity files.",
    "initial_state_assumption": "paired_pair_scoped_cutover_sensitivities_without_january_open_orders",
    "initial_state_assumption_reason": "January ERP open orders and large 021081/773474 snapshots masked the explicit quality incident. In the quality cascade only, three stocks on the documented 021081-to-268967 path are stressed before the 240-day warm-up, then the common measured-day-0 M-1430/773474 balance is set to 25% with FIFO lot reconciliation before the J0 hash. The 20% sensitivity created a customer shortage in the incident-free reference for seed 330282, while 30% absorbed the quality incident for seeds 330281 and 330283; 25% is therefore the explicit calibration candidate to be tested across the final seed set. Every normal, untreated and treated arm uses the same two CSV files. Other materials and the historical cold-start artifacts remain untouched.",
    "c2_measurement_start_sensitivity_scales": {
      "M-1810/item:338929": 0.3,
      "DC-1920/item:268091": 1.0
    },
    "c2_opening_finished_stock_scale": 1.25,
    "c2_measurement_start_sensitivity_reason": "In the 338929-to-268091 cascade only, the paired measured-J0 on-hand balance and native standard in-transit pipeline for component M-1810/338929 retain 30 percent of the simulated cutover state. The finished-product DC-1920/268091 balance and pipeline are no longer stressed. Blind seed 330290 showed that scaling the finished-product pipeline itself created a day-0 customer shortage unrelated to the delayed component; even at full pipeline, 78,471 units of backlog were inherited from warm-up because the historical opening stock had been exhausted. A separate paired opening-stock sensitivity therefore retains 125 percent of the DC-1920/268091 snapshot before warm-up. External and estimated-source pipelines are never scaled. These are demonstrator sensitivities, not claims about current ERP stock.",
    "horizon_reason": "The 021081 upstream lane is capped at 240 days, the quarantine adds 90 days and downstream transport can add up to 66 days before lot waiting. The C2 incident begins at measured day 0, lasts 60 days and adds 35 transport days. A 720-day measured horizon leaves a long post-recovery tail for both cascades and makes recovery censoring explicit.",
    "state_dependent_background_risks": false,
    "state_dependent_background_risks_reason": "Explicit incidents are isolated so solution deltas are attributable. Common random numbers still pair stochastic lead-time draws.",
    "client_order_identifiers_available": false,
    "individual_order_count_claim": "not_identifiable_without_persistent_customer_order_ids"
  },
