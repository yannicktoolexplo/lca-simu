      ]
    },
    {
      "id": "SIMULATION-INPUT-002",
      "title": "Réserver le moteur et les sorties au serveur",
      "status": "documented",
      "statement": "HTTP impose le moteur et un nouveau dossier de résultats, refuse les arguments moteur libres et contrôle les chemins résolus sous la racine d'entrée. Le scénario doit exister et l'horizon être explicite et borné.",
      "scope": "POST /simulate du serveur local.",
      "units": "Chemins locaux, jours, identifiants de scénario et de run.",
      "limitations": "Pas de protection contre une modification concurrente des fichiers par un acteur local. Le contrat Python interne conserve ses options de confiance.",
      "references": [
        "http",
        "path",
        "fields",
        "forbidden-test",
        "paths-test",
        "unique-test"
      ],
      "sources": [
        "etudecas/docs/SIMULATION_INPUT_CONTRACT.md"
      ]
    },
    {
      "id": "SIMULATION-INPUT-003",
      "title": "Contrôler l'accès local et les exécutions simultanées",
      "status": "documented",
      "statement": "Le serveur local exige un jeton pour simuler, contrôle l'origine et l'hôte, limite le corps, réserve un seul créneau et applique un délai au sous-processus moteur. Les erreurs libèrent le créneau et ne sont pas annoncées comme succès.",
      "scope": "Service HTTP local avec configuration contrôlée par son opérateur.",
      "units": "Octets, secondes et nombre de simulations concurrentes.",
      "limitations": "Le délai ne couvre pas tout le prétraitement ni les descendants éventuels du moteur. Ni la mémoire, ni les sorties, ni le nombre de connexions ne sont bornés. Outil local uniquement.",
