  "rules": [
    {
      "id": "SIMULATION-INPUT-001",
      "title": "Interpréter les valeurs sans conversions ambiguës",
      "status": "documented",
      "statement": "Le parseur de dictionnaire exige des booléens réels, des jours et graines entiers non négatifs, et des multiplicateurs finis non négatifs. Il refuse les champs inconnus et exige une seule source de graphe.",
      "scope": "request_from_dict ; les objets internes construits directement ne passent pas par ce parseur.",
      "units": "Jours, graines entières et multiplicateurs sans dimension.",
      "limitations": "Zéro jour conserve la convention Python historique ; les planchers et effets physiques des multiplicateurs restent définis dans le moteur.",
      "references": [
        "parser",
        "scales",
        "flags",
        "overrides",
        "types-test",
        "scales-test",
        "false-test"
      ],
      "sources": [
