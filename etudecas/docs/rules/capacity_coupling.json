  "rules": [
    {
      "id": "CAPACITY-COUPLING-001",
      "title": "Le besoin peut modifier les capacités calculées",
      "status": "documented",
      "statement": "L'audit rejoue les capacités directes et amont en tenant compte du besoin, des capacités explicites, du stock, des lots et du taux d'utilisation. Changer le besoin peut donc modifier plusieurs mécanismes à la fois.",
      "scope": "Relecture analytique des paramètres fournisseurs ; pas une nouvelle simulation.",
      "units": "Quantité dans l'unité de l'article ; capacités en quantité par jour ; délais en jours.",
      "limitations": "L'audit ne prouve pas une équivalence permanente avec toutes les branches du moteur. Les résultats de la fixture ne sont pas des performances observées.",
