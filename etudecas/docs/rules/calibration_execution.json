    "rules":  [
                  {
                      "id":  "CALIBRATION-EXECUTION-001",
                      "title":  "Publier un fichier complet ou signaler l\u0027échec",
                      "status":  "documented",
                      "statement":  "La V2 publie chaque fichier par remplacement atomique. Elle retente uniquement les refus Windows 5, 32 et 33, dans une limite de six essais ; les autres erreurs et les refus persistants sont propagés.",
                      "scope":  "Écriture des JSON et CSV par le runner V2.",
                      "units":  "Secondes d\u0027attente, codes Windows, fichiers UTF-8.",
                      "limitations":  "Pas de transaction entre plusieurs fichiers ; pas de garantie contre une panne matérielle. Les reprises restent soumises au contrôle du registre.",
